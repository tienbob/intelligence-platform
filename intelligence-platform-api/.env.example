# ── Database ─────────────────────────────────────────────────────
# Shared single database with the Python intelligence service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/market_intelligence

# ── Rails secrets ────────────────────────────────────────────────
# Generate with: rails secret
SECRET_KEY_BASE=change-me
RAILS_MASTER_KEY=

# ── JWT (must match the Python FastAPI service conventions) ──────
JWT_SECRET_KEY=change-me-in-production-change-me-in-production-1234
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Python intelligence service (internal) ───────────────────────
PYTHON_INTERNAL_URL=http://localhost:8001
PYTHON_SERVICE_KEY=dev-service-key-change-me

# ── Auth toggle ──────────────────────────────────────────────────
AUTH_ENABLED=false

# ── Application domain ───────────────────────────────────────────
# Public host[:port] the app is served on (no scheme, no path) and its full
# origin. APP_DOMAIN feeds Rails Host Authorization (config.hosts) and the
# mailer host; APP_URL is the default CORS origin when CORS_ALLOWED_ORIGINS
# is unset. In production set both to your real hostname, e.g.
# APP_DOMAIN=app.example.com / APP_URL=https://app.example.com.
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated origins. Unset → falls back to APP_URL plus the local dev
# origins (Vite dev server on 5173, nginx on 3000).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000