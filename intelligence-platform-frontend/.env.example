# Auto-refresh intervals (milliseconds)
# Set to 0 to disable auto-refresh for a page.
VITE_REFRESH_DASHBOARD_MS=30000
VITE_REFRESH_ANALYSIS_JOBS_MS=5000
VITE_REFRESH_ANALYSIS_DETAIL_MS=5000

# Public origin of the app (scheme + host[:port]). Exposed as APP_URL from
# src/config.js for canonical/absolute URL construction. Must match the
# origin users actually browse (keep in sync with root APP_URL).
VITE_APP_URL=http://localhost:3000