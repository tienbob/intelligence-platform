# ── Application ──────────────────────────────────────────────
APP_NAME=AI Market Research & Investment Intelligence
APP_VERSION=0.1.0
DEBUG=false
# production (the default) enforces a fail-closed startup guard: the service
# refuses to boot with unset/known-default secrets. Use development locally.
ENVIRONMENT=development
# Compose uses ENVIRONMENT for both Python and Rails (including migrations).
# Production also requires real JWT_SECRET_KEY / PYTHON_SERVICE_KEY secrets
# and AUTH_ENABLED=true for the Rails gateway and its migration container.
# Local Rails images include development gems; production can exclude them
# by setting RAILS_BUNDLE_WITHOUT=development:test before building.
RAILS_BUNDLE_WITHOUT=test

# Inbound rate limiting (audit S03) — enforced by app.core.rate_limit_middleware
# on paid-work endpoints (analysis create, portfolio optimize). Per-user budgets
# keyed by the gateway-forwarded X-User-Id; set false only for local debugging.
RATE_LIMIT_ENABLED=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# ── Intelligence Domains ─────────────────────────────────────
# Explicit allow-list of enabled domain packs. Domains not listed stay
# disabled even when discovered on disk (e.g. hr). Omitting the variable
# enables EVERY discovered domain — avoid in deployments.
INTELLIGENCE_DOMAINS=stock

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_intelligence
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis cache (shared, persistent cache for external data) ──
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=86400
REDIS_CACHE_PREFIX=mi:cache:
REDIS_CACHE_DB=0
REDIS_CACHE_TIMEOUT_SEC=2.0

# ── Provider API Keys ────────────────────────────────────────
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_RATE_LIMIT=5

SEC_USER_AGENT=Market Intelligence research@example.com
SEC_BASE_URL=https://data.sec.gov

FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred

FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ── LLM ──────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# App-level retry for transient provider errors (429 rate limits, 5xx
# demand spikes, timeouts) — exponential backoff with jitter, then a
# fallback model (same provider/base_url) before failing the job.
# Free-tier daily-quota 429s fail over immediately (no futile backoff).
LLM_MAX_ATTEMPTS=6
LLM_RETRY_BASE_DELAY=10.0
LLM_RETRY_MAX_DELAY=120.0
LLM_FALLBACK_MODEL=

# ── Embeddings ───────────────────────────────────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# ── Background Processing ────────────────────────────────────
SCHEDULER_TIMEZONE=UTC
MARKET_DATA_UPDATE_INTERVAL_MIN=5
NEWS_PROCESSING_INTERVAL_MIN=10
ANOMALY_DETECTION_INTERVAL_MIN=15
EVENT_ANALYSIS_INTERVAL_HR=1
FUNDAMENTALS_UPDATE_INTERVAL_HR=24
SCORE_RECALCULATION_INTERVAL_HR=24

# ── Investment Scoring Weights (must sum to 1.0; risk is subtracted) ──
SCORE_WEIGHT_FUNDAMENTAL=0.30
SCORE_WEIGHT_VALUATION=0.20
SCORE_WEIGHT_GROWTH=0.15
SCORE_WEIGHT_TECHNICAL=0.10
SCORE_WEIGHT_SENTIMENT=0.10
SCORE_WEIGHT_CATALYST=0.10
SCORE_WEIGHT_RISK=0.15

# ── Phase 6: Scoring Versioning (Section 59) ────────────────
SCORING_MODEL=investment_score_v1
SCORING_VERSION=1.0

# ── Phase 6: Recommendation Thresholds (Section 60) ──────────
# JSON list of {"threshold": float, "category": str}, evaluated top-to-bottom.
RECOMMENDATION_THRESHOLDS=[{"threshold": 80, "category": "STRONG_OPPORTUNITY"},{"threshold": 70, "category": "OPPORTUNITY"},{"threshold": 60, "category": "WATCH"},{"threshold": 45, "category": "NEUTRAL"},{"threshold": 30, "category": "CAUTION"},{"threshold": 15, "category": "HIGH_RISK"},{"threshold": 0, "category": "AVOID"}]

# ── Phase 6: Data Quality Weights (Section 62) ───────────────
# JSON dict of component → weight. Values are 0..1; scaled to a weighted average.
DATA_QUALITY_WEIGHTS={"price": 0.30, "fundamental": 0.30, "technical": 0.15, "news": 0.15, "events": 0.10}

# Base confidence when no data quality data is available.
BASE_CONFIDENCE=0.50

# Minimum data quality score required for a meaningful recommendation.
MIN_DATA_QUALITY_FOR_RECOMMENDATION=0.40

# ── Analysis Engine (PLAN Gate 5.1) ──────────────────────────
# Which analysis execution engine serves BOTH production entry points
# (API + scheduled worker) via a single dispatch point.
#   legacy    = pre-migration orchestration (current default)
#   framework = IntelligencePipeline execution path
ANALYSIS_ENGINE=legacy

# ── Frontend auto-refresh intervals (milliseconds, 0 = disabled) ──
VITE_REFRESH_DASHBOARD_MS=30000
VITE_REFRESH_ANALYSIS_JOBS_MS=5000
VITE_REFRESH_ANALYSIS_DETAIL_MS=5000
